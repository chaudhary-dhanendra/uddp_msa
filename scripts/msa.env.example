# Copy to deploy\local\msa.env (gitignored) and fill in. scripts\start-all.ps1 reads it; a variable already set in
# the PowerShell window wins over this file. Never commit the filled-in copy.

# Password of the service roles created by deploy\postgres\02-msa-service-roles.sql (required).
UDDP_MSA_SERVICE_PASSWORD=

# Same random value for every service (docs/security.md). Leave empty to get a new one on every start.
UDDP_INTERNAL_TOKEN=

# Defaults shown; change only if your PostgreSQL or Kafka is elsewhere.
UDDP_POSTGRES_HOST=localhost
UDDP_POSTGRES_PORT=5432
UDDP_KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# Apache Hop for real ingestion (docs/dev-setup.md).
# HOP_HOME=D:\tools\apache-hop-2.19.0
