{
  "name": "uddp-onboarding-ui",
  "private": true,
  "version": "0.12.0",
  "type": "module",
  "description": "UDDP operational UI: read-mostly views from onboarding to Golden Resident (M12); Onboarding Studio plugs in at M13",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write \"src/**/*.{ts,tsx,css,json}\" \"*.{ts,json}\"",
    "typecheck": "tsc -b",
    "gen:api": "openapi-typescript openapi.json -o src/api/schema.d.ts",
    "check:api": "node scripts/check-api-generated.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "screenshots": "playwright test --project=screenshots"
  },
  "dependencies": {
    "@tanstack/react-query": "5.62.0",
    "openapi-fetch": "0.13.3",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router-dom": "6.28.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.10.1",
    "@eslint/js": "9.16.0",
    "@playwright/test": "1.49.1",
    "@testing-library/jest-dom": "6.6.3",
    "@testing-library/react": "16.1.0",
    "@testing-library/user-event": "14.5.2",
    "@types/node": "22.10.2",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "4.3.4",
    "eslint": "9.16.0",
    "eslint-plugin-react-hooks": "5.1.0",
    "eslint-plugin-react-refresh": "0.4.16",
    "globals": "15.13.0",
    "jsdom": "25.0.1",
    "openapi-typescript": "7.4.4",
    "prettier": "^3.4.2",
    "typescript": "5.7.2",
    "typescript-eslint": "8.18.0",
    "vite": "6.0.3",
    "vitest": "2.1.8"
  }
}
