<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <!--
    UDDP microservices build (docs/msa-design.md). common-core is the imported monolith; it keeps its own
    spring-boot-starter-parent so its build and tests are unchanged, and is only aggregated here. The contracts
    module and the service modules inherit this POM.
  -->
  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>3.5.6</version>
    <relativePath/>
  </parent>

  <groupId>gov.uddp</groupId>
  <artifactId>uddp-msa</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <packaging>pom</packaging>

  <modules>
    <module>engine</module>
    <module>common-core</module>
    <module>contracts</module>
    <module>messaging</module>
    <module>services/ingestion-service</module>
    <module>services/canonical-service</module>
    <module>services/identity-service</module>
    <module>services/registry-service</module>
    <module>services/statepack-service</module>
    <module>services/api-stewardship-service</module>
    <module>e2e</module>
  </modules>

  <properties>
    <java.version>21</java.version>
    <json-schema-validator.version>1.5.6</json-schema-validator.version>
  </properties>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>gov.uddp</groupId>
        <artifactId>uddp-contracts</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>gov.uddp</groupId>
        <artifactId>uddp-messaging</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>com.networknt</groupId>
        <artifactId>json-schema-validator</artifactId>
        <version>${json-schema-validator.version}</version>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <build>
    <pluginManagement>
      <plugins>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-surefire-plugin</artifactId>
          <configuration>
            <!-- Tests use disposable Testcontainers databases only; never inherit the developer's DB settings. -->
            <excludedEnvironmentVariables>
              <excludedEnvironmentVariable>UDDP_POSTGRES_URL</excludedEnvironmentVariable>
              <excludedEnvironmentVariable>UDDP_POSTGRES_HOST</excludedEnvironmentVariable>
              <excludedEnvironmentVariable>UDDP_POSTGRES_PORT</excludedEnvironmentVariable>
              <excludedEnvironmentVariable>UDDP_POSTGRES_DB</excludedEnvironmentVariable>
              <excludedEnvironmentVariable>UDDP_POSTGRES_USER</excludedEnvironmentVariable>
              <excludedEnvironmentVariable>UDDP_POSTGRES_PASSWORD</excludedEnvironmentVariable>
            </excludedEnvironmentVariables>
          </configuration>
        </plugin>
      </plugins>
    </pluginManagement>
  </build>
</project>
