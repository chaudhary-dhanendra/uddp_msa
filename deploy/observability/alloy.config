// Grafana Alloy: tails the services' JSON log files (UDDP_LOG_DIR, mounted at /var/log/uddp) and sends them to Loki,
// labelled by service and level, with the trace id kept so Grafana links each line to its trace in Tempo.
local.file_match "uddp" {
  path_targets = [{"__path__" = "/var/log/uddp/*.log"}]
}

loki.source.file "uddp" {
  targets    = local.file_match.uddp.targets
  forward_to = [loki.process.uddp.receiver]
}

loki.process "uddp" {
  stage.json {
    // Spring Boot's ECS JSON: service.name and log.level are nested; the trace id comes from the MDC.
    expressions = {service = "service.name", level = "log.level", trace_id = "traceId || trace.id"}
  }
  stage.labels {
    values = {service = "", level = ""}
  }
  stage.structured_metadata {
    values = {trace_id = ""}
  }
  forward_to = [loki.write.local.receiver]
}

loki.write "local" {
  endpoint {
    url = "http://loki:3100/loki/api/v1/push"
  }
}
