    <use_batch>Y</use_batch>
    <attributes/>
    <GUI><xloc>896</xloc><yloc>128</yloc></GUI>
  </transform>
  <order>
    <hop><from>Excel rows</from><to>Build raw payload</to><enabled>Y</enabled></hop>
    <hop><from>Build raw payload</from><to>Selected non-empty rows</to><enabled>Y</enabled></hop>
