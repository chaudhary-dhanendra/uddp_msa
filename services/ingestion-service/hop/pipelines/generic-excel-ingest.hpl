    <pipeline_type>Normal</pipeline_type>
    <pipeline_status>0</pipeline_status>
    <parameters>
      <parameter>
        <name>FILE</name>
        <description>Excel workbook (absolute path)</description>
        <default_value/>
      </parameter>
      <parameter>
        <name>SHEETS</name>
        <description>comma-separated sheet names, or * for every sheet</description>
        <default_value/>
      </parameter>
      <parameter>
        <name>STATE_CODE</name>
        <description>state pack state code</description>
        <default_value/>
      </parameter>
      <parameter>
        <name>SOURCE_SYSTEM</name>
        <description>source system identifier</description>
        <default_value/>
      </parameter>
      <parameter>
        <name>SOURCE_ENTITY</name>
        <description>source entity identifier retained in source metadata</description>
        <default_value/>
      </parameter>
      <parameter>
        <name>SOURCE_SCHEMA_VERSION</name>
        <description>source schema version</description>
        <default_value/>
      </parameter>
      <parameter>
        <name>STATE_PACK_VERSION</name>
        <description>state pack version</description>
        <default_value/>
      </parameter>
      <parameter>
        <name>BATCH_ID</name>
        <description>existing ingestion_batch UUID</description>
        <default_value/>
      </parameter>
      <parameter>
        <name>RAW_SCHEMA</name>
        <description>schema of the raw_record table (public in the monolith, ingestion in ingestion-service)</description>
        <default_value>public</default_value>
      </parameter>
    </parameters>
    <name>generic-excel-ingest</name>
    <name_sync_with_filename>Y</name_sync_with_filename>
