  <transform>
    <type>ScriptValueMod</type>
    <name>Build raw payload</name>
    <description>Builds the source-faithful xlsx payload; drops rows whose cells are all empty or whose sheet is not selected.</description>
    <distribute>Y</distribute><custom_distribution/><copies>1</copies>
    <partitioning><method>none</method><schema_name/></partitioning>
    <compatible>N</compatible>
    <optimizationLevel>9</optimizationLevel>
    <jsScripts>
      <jsScript>
        <jsScript_type>0</jsScript_type>
        <jsScript_name>payload</jsScript_name>
        <jsScript_script><![CDATA[// An empty sheet list reads every sheet; SHEETS narrows it here. Nothing is interpreted.
var wanted = getVariable("SHEETS", "*");
var keep = "N";
var cells = [c001,c002,c003,c004,c005,c006,c007,c008,c009,c010,c011,c012,c013,c014,c015,c016,c017,c018,c019,c020,c021,c022,c023,c024,c025,c026,c027,c028,c029,c030,c031,c032,c033,c034,c035,c036,c037,c038,c039,c040,c041,c042,c043,c044,c045,c046,c047,c048,c049,c050,c051,c052,c053,c054,c055,c056,c057,c058,c059,c060,c061,c062,c063,c064,c065,c066,c067,c068,c069,c070,c071,c072,c073,c074,c075,c076,c077,c078,c079,c080,c081,c082,c083,c084,c085,c086,c087,c088,c089,c090,c091,c092,c093,c094,c095,c096,c097,c098,c099,c100,c101,c102,c103,c104,c105,c106,c107,c108,c109,c110,c111,c112,c113,c114,c115,c116,c117,c118,c119,c120,c121,c122,c123,c124,c125,c126,c127,c128,c129,c130,c131,c132,c133,c134,c135,c136,c137,c138,c139,c140,c141,c142,c143,c144,c145,c146,c147,c148,c149,c150,c151,c152,c153,c154,c155,c156,c157,c158,c159,c160,c161,c162,c163,c164,c165,c166,c167,c168,c169,c170,c171,c172,c173,c174,c175,c176,c177,c178,c179,c180,c181,c182,c183,c184,c185,c186,c187,c188,c189,c190,c191,c192,c193,c194,c195,c196,c197,c198,c199,c200];
var last = -1;
for (var i = 0; i < cells.length; i++) {
  cells[i] = (cells[i] == null) ? "" : String(cells[i]);
  if (cells[i] !== "") { last = i; }
}
cells = cells.slice(0, last + 1);
var selected = (wanted === "*");
if (!selected) {
  var list = String(wanted).split(",");
  for (var j = 0; j < list.length; j++) { if (list[j].replace(/^\s+|\s+$/g, "") === String(sheet_name)) { selected = true; } }
}
if (selected && last >= 0) { keep = "Y"; }
var raw_payload = JSON.stringify({format: "xlsx", file: getVariable("FILE", ""), sheet: String(sheet_name),
  row: Number(sheet_row_number), cells: cells});
var source_metadata = JSON.stringify({sourceEntity: getVariable("SOURCE_ENTITY", "")});
// The row in the sheet as Excel numbers it (Hop's sheet row number is already 1-based).
var source_line = Number(sheet_row_number);
]]></jsScript_script>
      </jsScript>
    </jsScripts>
    <fields>
      <field><name>keep</name><rename>keep</rename><type>String</type><length>-1</length><precision>-1</precision><replace>N</replace></field>
      <field><name>raw_payload</name><rename>raw_payload</rename><type>String</type><length>-1</length><precision>-1</precision><replace>N</replace></field>
      <field><name>source_metadata</name><rename>source_metadata</rename><type>String</type><length>-1</length><precision>-1</precision><replace>N</replace></field>
      <field><name>source_line</name><rename>source_line</rename><type>Integer</type><length>-1</length><precision>-1</precision><replace>N</replace></field>
    </fields>
    <attributes/>
    <GUI><xloc>320</xloc><yloc>128</yloc></GUI>
  </transform>
  <transform>
    <type>FilterRows</type>
    <name>Selected non-empty rows</name>
    <distribute>Y</distribute><custom_distribution/><copies>1</copies>
    <partitioning><method>none</method><schema_name/></partitioning>
    <send_true_to/><send_false_to/>
    <compare>
      <condition>
        <negated>N</negated>
        <leftvalue>keep</leftvalue>
        <function>=</function>
        <rightvalue/>
        <value><name>constant</name><type>String</type><text>Y</text><length>-1</length><precision>-1</precision><isnull>N</isnull></value>
      </condition>
    </compare>
    <attributes/>
    <GUI><xloc>512</xloc><yloc>128</yloc></GUI>
  </transform>
  <transform>
    <type>GetVariable</type>
    <name>Technical metadata</name>
    <description>Adds runtime provenance without interpreting source fields.</description>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <fields>
      <field>
        <name>batch_id</name>
        <type>String</type>
        <format/>
        <currency/>
        <decimal/>
        <group/>
        <variable>${BATCH_ID}</variable>
      </field>
      <field>
        <name>state_code</name>
        <type>String</type>
        <format/>
        <currency/>
        <decimal/>
        <group/>
        <variable>${STATE_CODE}</variable>
      </field>
      <field>
        <name>source_system</name>
        <type>String</type>
        <format/>
        <currency/>
        <decimal/>
        <group/>
        <variable>${SOURCE_SYSTEM}</variable>
      </field>
      <field>
        <name>state_pack_version</name>
        <type>String</type>
        <format/>
        <currency/>
        <decimal/>
        <group/>
        <variable>${STATE_PACK_VERSION}</variable>
      </field>
      <field>
        <name>source_schema_version</name>
        <type>String</type>
        <format/>
        <currency/>
        <decimal/>
        <group/>
        <variable>${SOURCE_SCHEMA_VERSION}</variable>
      </field>
      <field>
        <name>pipeline_template</name>
        <type>String</type>
        <format/>
        <currency/>
        <decimal/>
        <group/>
        <variable>generic-excel-ingest.hpl</variable>
      </field>
      <field>
        <name>source_entity</name>
        <type>String</type>
        <format/>
        <currency/>
        <decimal/>
        <group/>
        <variable>${SOURCE_ENTITY}</variable>
      </field>
    </fields>
    <attributes/>
    <GUI>
      <xloc>704</xloc>
      <yloc>128</yloc>
    </GUI>
  </transform>
  <transform>
    <type>TableOutput</type>
    <name>PostgreSQL raw_record</name>
    <description>Persists raw source records only.</description>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning><method>none</method><schema_name/></partitioning>
    <commit>1000</commit>
    <connection>uddp-postgres</connection>
    <fields>
      <field><column_name>batch_id</column_name><stream_name>batch_id</stream_name></field>
      <field><column_name>state_code</column_name><stream_name>state_code</stream_name></field>
      <field><column_name>source_system</column_name><stream_name>source_system</stream_name></field>
      <field><column_name>raw_payload</column_name><stream_name>raw_payload</stream_name></field>
      <field><column_name>source_metadata</column_name><stream_name>source_metadata</stream_name></field>
      <field><column_name>state_pack_version</column_name><stream_name>state_pack_version</stream_name></field>
      <field><column_name>source_schema_version</column_name><stream_name>source_schema_version</stream_name></field>
