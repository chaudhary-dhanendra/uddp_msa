{
  "provider": "canonical-service",
  "description": "The held-records API the edge calls (RemoteHeldStore) after it has checked the user's permission, scope and maker-checker. {batch}, {reason}, {held} and {job} come from the provider state each test sets up.",
  "interactions": [
    {
      "name": "group the waiting held records",
      "consumers": ["edge-service: RemoteHeldStore.groups"],
      "request": {"method": "GET", "path": "/api/canonical/held-records/groups?samples=5"},
      "response": {
        "status": 200,
        "fields": ["[].batchId", "[].reasonCode", "[].stateCode", "[].count", "[].shareOfBatchPercent", "[].samples"],
        "example": [{"batchId": "11111111-1111-1111-1111-111111111111", "reasonCode": "RULE_FAILED:name-required",
                     "stateCode": "XX", "count": 1, "shareOfBatchPercent": 100.0, "samples": []}]
      }
    },
    {
      "name": "read a held record with its history",
      "consumers": ["edge-service: RemoteHeldStore.find"],
      "request": {"method": "GET", "path": "/api/canonical/held-records/{held}"},
      "response": {
        "status": 200,
        "fields": ["record.heldId", "record.batchId", "record.stateCode", "record.status", "record.reasons", "history"],
        "example": {"record": {"heldId": "22222222-2222-2222-2222-222222222222",
                               "batchId": "11111111-1111-1111-1111-111111111111", "rawRecordId": "33333333-3333-3333-3333-333333333333",
                               "sourceSystem": "pds", "stateCode": "XX", "statePackVersion": "1.0.0",
                               "reasons": [{"code": "RULE_FAILED:name-required", "message": "name is required",
                                            "field": "name", "severity": "ERROR"}],
                               "status": "OPEN", "currentPayload": {}, "correctionVersion": 0},
                    "history": []}
      }
    },
    {
      "name": "count a group's waiting records",
      "consumers": ["edge-service: RemoteHeldStore.waitingCount", "edge-service: RemoteHeldStore.batchState"],
      "request": {"method": "GET", "path": "/api/canonical/held-records/groups/{batch}/{reason}/waiting"},
      "response": {"status": 200, "fields": ["count", "stateCode"], "example": {"count": 1, "stateCode": "XX"}}
    },
    {
      "name": "reprocess a group in the background",
      "consumers": ["edge-service: RemoteHeldStore.startReprocess"],
      "request": {"method": "POST", "path": "/api/canonical/held-records/groups/{batch}/{reason}/reprocess",
                  "body": {"actor": "sam.steward"}},
      "response": {
        "status": 202,
        "fields": ["jobId", "batchId", "reasonCode", "status", "total", "processed", "released", "stillHeld"],
        "example": {"jobId": "44444444-4444-4444-4444-444444444444", "batchId": "11111111-1111-1111-1111-111111111111",
                    "reasonCode": "RULE_FAILED:name-required", "status": "RUNNING", "total": 1, "processed": 0,
                    "released": 0, "stillHeld": 0, "requestedBy": "sam.steward"}
      }
    },
    {
      "name": "read a reprocess job",
      "consumers": ["edge-service: RemoteHeldStore.reprocessJob"],
      "request": {"method": "GET", "path": "/api/canonical/held-records/reprocess-jobs/{job}"},
      "response": {
        "status": 200,
        "fields": ["jobId", "status", "total", "processed", "released", "stillHeld"],
        "example": {"jobId": "44444444-4444-4444-4444-444444444444", "batchId": "11111111-1111-1111-1111-111111111111",
                    "reasonCode": "RULE_FAILED:name-required", "status": "COMPLETED", "total": 1, "processed": 1,
                    "released": 0, "stillHeld": 1, "requestedBy": "sam.steward"}
      }
    },
    {
      "name": "held-record metrics",
      "consumers": ["edge-service: RemoteHeldStore.metrics"],
      "request": {"method": "GET", "path": "/api/canonical/held-records/metrics"},
      "response": {
        "status": 200,
        "fields": ["countsByStatus", "oldestWaitingSeconds", "meanSecondsToDecide"],
        "example": {"countsByStatus": {"OPEN": 1}, "oldestWaitingSeconds": 60.0, "meanSecondsToDecide": 0.0}
      }
    },
    {
      "name": "held share of a delivery",
      "consumers": ["edge-service: RemoteHeldStore.share (ReleaseService held-share gate)"],
      "request": {"method": "GET", "path": "/api/canonical/held-records/batches/{batch}/share"},
      "response": {
        "status": 200,
        "fields": ["held", "rejected", "rows"],
        "example": {"held": 1, "rejected": 0, "rows": 3}
      }
    }
  ]
}
