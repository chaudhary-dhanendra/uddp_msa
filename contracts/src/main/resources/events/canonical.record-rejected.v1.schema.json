{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://uddp.gov/events/canonical.record-rejected.v1.schema.json",
  "title": "Canonical record rejected v1 (business-invalid record, topic uddp.canonical.dlq.v1)",
  "type": "object",
  "required": ["rawRecordId", "batchId", "errors"],
  "properties": {
    "rawRecordId": { "type": "string", "format": "uuid" },
    "batchId": { "type": "string", "format": "uuid" },
    "errors": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["ruleId", "reasonCode"],
        "properties": {
          "ruleId": { "type": "string" },
          "field": { "type": ["string", "null"] },
          "reasonCode": { "type": "string" },
          "message": { "type": ["string", "null"] }
        }
      }
    }
  }
}
