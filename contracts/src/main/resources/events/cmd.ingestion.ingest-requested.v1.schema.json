{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://uddp.gov/events/cmd.ingestion.ingest-requested.v1.schema.json",
  "title": "Ingest requested v1: run one generic Hop template with an allow-listed parameter set (ARCHITECTURE.md A)",
  "type": "object",
  "required": ["batchId", "sourceSystem", "sourceType", "statePackVersion", "pipelineTemplate", "parameters"],
  "properties": {
    "batchId": { "type": "string", "format": "uuid" },
    "sourceSystem": { "type": "string", "minLength": 1 },
    "sourceType": { "type": "string", "minLength": 1 },
    "sourceSchemaVersion": { "type": ["string", "null"] },
    "statePackVersion": { "type": "string", "minLength": 1 },
    "pipelineTemplate": {
      "type": "string",
      "enum": ["generic-file-ingest.hpl", "generic-excel-ingest.hpl", "generic-db-ingest.hpl"]
    },
    "fileRef": {
      "type": ["string", "null"],
      "pattern": "^sha256:[0-9a-f]{64}/[A-Za-z0-9._ -]{1,200}$",
      "description": "A file uploaded to ingestion-service (POST /api/ingestion/files); replaces SOURCE_FILE or FILE."
    },
    "connectionRef": {
      "type": ["string", "null"],
      "description": "A database source's connection name, configured (with its credentials) only in ingestion-service."
    },
    "delivery": {
      "type": ["string", "null"],
      "enum": ["auto", null],
      "description": "auto: ingestion-service takes the delivery from the source's connector, the uploaded file, the source's landing folder or its file path, in that order."
    },
    "location": { "type": ["string", "null"], "description": "The source's file or landing-folder location." },
    "table": { "type": ["string", "null"] },
    "query": { "type": ["string", "null"] },
    "parameters": {
      "type": "object",
      "propertyNames": {
        "enum": ["SOURCE_FILE", "CSV_HEADER", "FILE", "SHEETS", "STATE_CODE", "SOURCE_SYSTEM", "SOURCE_ENTITY",
                 "SOURCE_SCHEMA_VERSION", "STATE_PACK_VERSION", "BATCH_ID"]
      },
      "additionalProperties": { "type": ["string", "null"] }
    }
  }
}
